{
  "info": {
    "_postman_id": "c3f9d1b2-2a9b-4e6f-9d2a-abcdef012345",
    "name": "Banking - Customer & Account Controllers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API collection for CustomerController and AccountController (create/read/update/delete + deposit/withdraw)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "customerNumber", "value": "", "type": "string" },
    { "key": "accountId", "value": "", "type": "string" },
    { "key": "accountNumber", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Walker\",\n  \"email\": \"alice.walker@example.com\",\n  \"dateOfBirth\": \"1992-07-21\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api","customers"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Created 201', ()=> pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "if(json.customerId) pm.environment.set('customerId', json.customerId);",
                "if(json.customerNumber) pm.environment.set('customerNumber', json.customerNumber);"
              ] }
            }
          ]
        },
        {
          "name": "Get Customer by ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api","customers","{{customerId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "Get Customer by Number",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers/number/{{customerNumber}}", "host": ["{{baseUrl}}"], "path": ["api","customers","number","{{customerNumber}}"] } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"AliceUpdated\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api","customers","{{customerId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "List Customers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api","customers"] } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account (requires customerNumber)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"ACC-20001\",\n  \"accountType\": \"SAVINGS\",\n  \"balance\": 10000.00,\n  \"currency\": \"INR\",\n  \"ifscCode\": \"HDFC0000001\",\n  \"branchCode\": \"BR-001\",\n  \"branchName\": \"Main\",\n  \"minimumBalance\": 500.00,\n  \"openedDate\": \"2026-01-01\",\n  \"status\": \"ACTIVE\",\n  \"customerNumber\": \"{{customerNumber}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/account", "host": ["{{baseUrl}}"], "path": ["api","account"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Created 201', ()=> pm.response.to.have.status(201));",
                "const json=pm.response.json(); if(json.accountId) pm.environment.set('accountId', json.accountId); if(json.accountNumber) pm.environment.set('accountNumber', json.accountNumber);"
              ] }
            }
          ]
        },
        {
          "name": "Get Account by ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/account/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api","account","{{accountId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "List Accounts",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/account/accounts", "host": ["{{baseUrl}}"], "path": ["api","account","accounts"] } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "Deposit",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 2500.00\n}" },
            "url": { "raw": "{{baseUrl}}/api/account/{{accountId}}/deposit", "host": ["{{baseUrl}}"], "path": ["api","account","{{accountId}}","deposit"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 1500.00\n}" },
            "url": { "raw": "{{baseUrl}}/api/account/{{accountId}}/withdraw", "host": ["{{baseUrl}}"], "path": ["api","account","{{accountId}}","withdraw"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('OK 200', ()=> pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "Delete Account",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/account/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api","account","{{accountId}}"] } }
        }
      ]
    }
  ]
}
